# Mi Óptica — Auditoría Browser

## 0. Flujo del Agente

```
1. terminal → bash scripts/ux-quick-audit.sh (audit-cli.mdc)
2. terminal → ./mvnw spring-boot:run -q & && sleep 8
3. browser  → navigate("http://localhost:8080/{modulo}")
4. browser  → screenshot("audit-before-{modulo}.png")
5. browser  → executeScript(SCRIPT DE SECCIÓN 1)
6. browser  → captureConsole() → guardar reporte
7. browser  → screenshot("audit-after-{modulo}.png")
8. Generar  → audit-report-{modulo}-{fecha}.md (Sección 2)
```

## 1. Script Maestro de Auditoría (inyectar en browser)

```javascript
// ════════════════════════════════════════════════════
// MI ÓPTICA — Browser UX Audit v2.0
// Pegar en consola del browser de Antigravity
// ════════════════════════════════════════════════════

const R = { e: [], w: [], p: [],
  add(l, cat, msg, el) {
    const o = { cat, msg, el: el?.outerHTML?.slice(0,100) };
    l==='e'?this.e.push(o):l==='w'?this.w.push(o):this.p.push(o);
  },
  print() {
    console.group('%cMi Óptica — UX Audit', 'font-size:15px;font-weight:700;color:#0D1B2A');
    console.log(`❌ ${this.e.length} errores  ⚠ ${this.w.length} advertencias  ✓ ${this.p.length} ok`);
    if (this.e.length) {
      console.group('❌ ERRORES (bloquean PR)');
      this.e.forEach(x => console.log(`[${x.cat}] ${x.msg}`, x.el||''));
      console.groupEnd();
    }
    if (this.w.length) {
      console.group('⚠️ ADVERTENCIAS');
      this.w.forEach(x => console.log(`[${x.cat}] ${x.msg}`, x.el||''));
      console.groupEnd();
    }
    console.groupEnd();
    return { errors: this.e.length, warnings: this.w.length, passes: this.p.length };
  }
};

// ── helpers ──
const lum = (r,g,b) => {
  return [r,g,b].map(c=>{const s=c/255; return s<=.03928?s/12.92:((s+.055)/1.055)**2.4})
    .reduce((a,c,i)=>a+[.2126,.7152,.0722][i]*c, 0);
};
const hex2rgb = h => [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)];
const rgb2hex = s => { const m=s.match(/\d+/g); return m?'#'+m.slice(0,3).map(n=>+n<16?'0'+parseInt(n).toString(16):parseInt(n).toString(16)).join(''):null; };
const contrast = (a,b) => { const l1=lum(...hex2rgb(a)), l2=lum(...hex2rgb(b));
  return (Math.max(l1,l2)+.05)/(Math.min(l1,l2)+.05); };

// ── 1. Contraste WCAG ──────────────────────────────────
document.querySelectorAll('p,span,h1,h2,h3,h4,h5,h6,a,label,td,th,button,.badge,.alert').forEach(el=>{
  const s = getComputedStyle(el);
  const fg = rgb2hex(s.color), bg = rgb2hex(s.backgroundColor);
  if(!fg||!bg||bg==='#000000') return;
  const r = contrast(fg,bg);
  const large = parseFloat(s.fontSize)>=18 || (parseFloat(s.fontSize)>=14 && parseInt(s.fontWeight)>=700);
  const min = large ? 3.0 : 4.5;
  if(r<min) R.add('e','WCAG',`ratio ${r.toFixed(1)}:1 (min ${min}) fg:${fg} bg:${bg} ${s.fontSize}`,el);
  else if(r>=7) R.add('p','WCAG',`${r.toFixed(1)}:1 AAA ✓`);
});

// ── 2. Cyan-400 como texto ─────────────────────────────
document.querySelectorAll('*').forEach(el=>{
  const h = rgb2hex(getComputedStyle(el).color);
  if(h==='#00b4d8') R.add('e','DESIGN','--cyan-400 (#00B4D8) como texto — usar --cyan-600',el);
});

// ── 3. Focus rings ─────────────────────────────────────
let fOk=0, fFail=0;
document.querySelectorAll('button,a[href],input,select,textarea,[tabindex]:not([tabindex="-1"])').forEach(el=>{
  el.focus({preventScroll:true});
  const s = getComputedStyle(el);
  const ok = (s.outlineWidth!=='0px'&&s.outlineStyle!=='none') || (s.boxShadow&&s.boxShadow!=='none');
  el.blur();
  ok ? fOk++ : (fFail++, R.add('e','FOCUS','Sin focus ring visible',el));
});
if(fOk>0) R.add('p','FOCUS',`${fOk} elementos con focus ring ✓`);

// ── 4. ARIA ────────────────────────────────────────────
document.querySelectorAll('button').forEach(btn=>{
  const txt = btn.textContent.trim();
  const lbl = btn.getAttribute('aria-label')||btn.getAttribute('aria-labelledby');
  if(!txt&&!lbl) R.add('e','ARIA','Botón sin texto accesible',btn);
  const svg = btn.querySelector('svg');
  if(svg&&!svg.hasAttribute('aria-hidden')) R.add('w','ARIA','SVG sin aria-hidden="true"',svg);
});
document.querySelectorAll('input:not([type="hidden"])').forEach(inp=>{
  const lbl = inp.id ? document.querySelector(`label[for="${inp.id}"]`) : null;
  if(!lbl&&!inp.getAttribute('aria-label')&&!inp.getAttribute('aria-labelledby'))
    R.add('e','ARIA','Input sin label asociado',inp);
});
document.querySelectorAll('table').forEach(t=>{
  if(!t.getAttribute('aria-label')&&!t.querySelector('caption'))
    R.add('w','ARIA','Tabla sin aria-label ni <caption>',t);
});
document.querySelectorAll('.alert,[class*="alert"],.toast').forEach(el=>{
  if(!el.getAttribute('role')&&!el.getAttribute('aria-live'))
    R.add('w','ARIA','Alerta sin role="alert" o aria-live',el);
});

// ── 5. Tokens del design system ───────────────────────
const root = getComputedStyle(document.documentElement);
const required = [
  '--navy-900','--navy-700','--navy-500','--navy-100','--navy-50',
  '--cyan-700','--cyan-600','--cyan-400','--cyan-50',
  '--slate-700','--slate-500','--slate-300','--slate-100','--slate-50',
  '--success','--warning','--danger',
  '--sp-1','--sp-2','--sp-3','--radius-md','--radius-lg',
  '--dur-fast','--ease-std','--shadow-focus','--font-body','--font-mono'
];
const missing = required.filter(t=>!root.getPropertyValue(t).trim());
if(missing.length) R.add('e','TOKENS',`Tokens faltantes: ${missing.join(', ')}`);
else R.add('p','TOKENS',`${required.length} tokens declarados ✓`);

// ── 6. Tipografía ──────────────────────────────────────
const bodyFont = getComputedStyle(document.body).fontFamily;
if(!bodyFont.toLowerCase().includes('urbanist')&&!bodyFont.toLowerCase().includes('system'))
  R.add('w','TYPO',`Fuente del body: "${bodyFont.slice(0,40)}" — esperada: Urbanist`);
else R.add('p','TYPO','Fuente del body correcta ✓');

document.querySelectorAll('*').forEach(el=>{
  const size = parseFloat(getComputedStyle(el).fontSize);
  if(size<11&&el.textContent.trim().length>0)
    R.add('w','TYPO',`font-size ${size}px (mínimo 11px)`,el);
});

// ── 7. Micro-interacciones ────────────────────────────
document.querySelectorAll('.btn-primary,.btn-accent,.btn-secondary').forEach(btn=>{
  const t = getComputedStyle(btn).transition;
  if(!t||t==='all 0s ease 0s') R.add('w','UX','Botón sin transition CSS',btn);
});
document.querySelectorAll('.card-interactive').forEach(c=>{
  const t = getComputedStyle(c).transition;
  if(!t||t==='all 0s ease 0s') R.add('w','UX','card-interactive sin transition',c);
});

// ── RESULTADO ─────────────────────────────────────────
const res = R.print();
console.table({
  'Errores': res.errors,
  'Advertencias': res.warnings,
  'Checks OK': res.passes,
  'Estado': res.errors===0 ? '✅ APROBADO' : '❌ REQUIERE FIXES'
});
```

## 2. Reporte de Salida — Formato Markdown

El agente guarda en `audit-reports/audit-{modulo}-{fecha}.md`:

```markdown
# UX Audit — {Módulo} — {Fecha}

## Resultado: {✅ APROBADO | ❌ REQUIERE FIXES}

| Categoría | Errores | Warnings | OK |
|---|---|---|---|
| WCAG Contraste | X | X | X |
| WCAG ARIA | X | X | X |
| Design Tokens | X | X | X |
| Tipografía | X | X | X |
| UX / Interacciones | X | X | X |

## Fixes Aplicados Automáticamente
- `templates/X.html:42` — descripción del fix

## Pendiente Manual
- `templates/X.html:87` — descripción + razón por la que no se auto-corrigió

## Evidencia
- Antes: audit-before-{modulo}.png
- Después: audit-after-{modulo}.png
```

## 3. Clasificación de Severidad

| 🔴 BLOCKER | 🟠 ERROR | 🟡 WARNING |
|---|---|---|
| WCAG AA fail | Token obsoleto | Grid 8pt |
| `--cyan-400` en texto | Sin focus ring | Sin aria-label en tabla |
| Input sin label | `outline:none` solo | SVG sin aria-hidden |
| Token faltante | Botón sin aria-label | font-size < 11px |
